function [mod_spec, freqs_mod, freqs_spec] = compute_modulation_spectra(x, fs)

% compute the modulation spectrum of a sound (i.e. the frequency spectrum
% of the frequency spectrum). We do this because it is a good measure of
% the texture of a sound. 

% original by Lidea Shahidi
% edited by Saskia, 10.9.2026 onwards

    % calculating a spectrogram requires conducting multiple short-time
    % Fast Fourier Transforms. Set the length and overlap of the blocks
    % into which to divide the sound.
    block_length_sec = 0.035; % 35 ms
    block_shift_sec = 0.010; % 10 ms

    % convert these into indexable values
    block_length = floor(block_length_sec * fs);
    block_shift = floor(block_shift_sec * fs);

    % create a Hann window of the specified block length. This tapers the
    % data to zero at the beginning and end of each block, which removes
    % edge artefacts. 
    window = hann(block_length);

    % calculate the spectrogram using:
    % - the data
    % - the Hann window constructed earlier
    % - the overlap between blocks (block length minus block shift)
    % - the number of timepoints in the block.
    % - sampling rate
    % and specifying that frequency should be on the y-axis (and time on
    % the x-axis).
    % This returns the spectrogram (spec) and a vector of frequencies that
    % were used in the transform (freqs_spec). The maximum frequency is
    % half the sampling rate.
    [spec, freqs_spec] = spectrogram(x, window, block_length - block_shift, block_length, fs, 'yaxis'); 
    
    % we are now ready to compute the modulation spectrum (i.e. spectrum of
    % spectrum).

    % calculate the sampling rate of the spectrogram 
    fs_spec = fs/block_shift;
    
    % initialise a variable in which to store the modulation spectrum. (This
    % will include frequencies up to 50 Hz because the sampling rate of the
    % spectrogram is 100 Hz).
    mod_spec = [];
    % for each frequency in the spectrum (low to high)
    for f = 1:length(freqs_spec) 
        % compute modulation spectrum within each frequency band
        [freqs_mod, power] = compute_spectrum(spec(f,:),fs_spec); 
        % add this onto the bottom of the output variable mod_spec.
        % mod_spec has ordinary frequencies (i.e. frequencies of the
        % spectrogram) in 
        mod_spec = [mod_spec; power]; 
    end

    % mod_spec includes modulation frequencies up to 50 Hz
    % mod_spec specifies amplitude modulation power for frequency bands of the
    % spectrogram (in the y-axis/across rows) across modulation frequencies (in the x-axis/across columns)
    % visualise on a log scale to see differences across frequency bands, e.g. imagesc(log10(mod_spec))
end