function [f, power] = compute_spectrum(x,fs)

% runs within compute_modulation_spectra.m .

% original by Lidea Shahidi
% edited by Saskia, 10.9.2026 onwards

    % find the number of timepoints in the frequency band data
    n = length(x);

    % calculate the first output - the frequencies used in the modulation
    % spectrum
    % O:n/2 is the number of bands you will get (up to half the length of the input
    % data). fs/n is the bandwidth of each freqency band
    f = (0:n/2)*(fs/n);

    % conduct a Short-Time Fast Fourier Transform
    y = fft(x);
    % discard symmetric bins. This is valid because the FFTs of all
    % real-valued sounds (i.e. any sound that is made with vibrating air
    % molecules of 
    y = y(1:n/2+1);                         % discard symmetric bins
    power = abs(y).^2/n;                    % power is magnitude of fft coefficients squared
end

